# Copy to .env.local for development. Both values are safe to expose in the
# browser bundle — the publishable key is constrained by row level security.
# In CI these come from GitHub Actions *repository variables*, not secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix these with VITE_ and never commit real values;
# they live in Supabase Edge Function secrets.
#   STRAVA_CLIENT_ID
#   STRAVA_CLIENT_SECRET
#   ORS_API_KEY          (build-time only, for scripts/build-route.ts)
