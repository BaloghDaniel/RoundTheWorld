# Copy to .env.local for development. Both values are safe to expose in the
# browser bundle — the publishable key is constrained by row level security.
# In CI these come from GitHub Actions *repository variables*, not secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server-only. Never prefix these with VITE_ and never commit real values.
# STRAVA_* live in Supabase Edge Function secrets, not here.
#   STRAVA_CLIENT_ID
#   STRAVA_CLIENT_SECRET
#   STRAVA_STATE_SECRET   (any random string: openssl rand -base64 32)
#
# These two are needed locally for the one-off route build and seed:
#   ORS_API_KEY           OpenRouteService token (HeiGIT account, "basic key")
#   SUPABASE_SECRET_KEY   sb_secret_… from Settings → API Keys. Bypasses RLS.
